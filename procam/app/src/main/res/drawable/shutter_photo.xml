<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval"><solid android:color="#FFBDBDBD" /></shape>
            </item>
            <item>
                <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
            </item>
        </selector>
    </item>
</layer-list>
